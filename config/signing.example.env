# Copy to signing.local.env (ignored) and replace paths locally.
# Do NOT put passwords or tokens here. Only file paths.
ANDROID_SDK_ROOT="/absolute/path/to/android-sdk"
JAVA_HOME="/absolute/path/to/jdk-17"
JARVIS_KEYSTORE="/absolute/private/path/to/jarvis-release.jks"
JARVIS_SIGNING_PASSWORD_FILE="/absolute/private/path/to/signing-password"
